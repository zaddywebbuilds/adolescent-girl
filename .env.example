# ---------------------------------------------------------------------------
# Copy to .env.local for local work, and set the same values in the Vercel
# project settings for production. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Required before the site can take a payment --------------------------

# Paystack secret key. Server only. Starts sk_test_ in test mode.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public key, exposed to the browser. Only needed if you later switch to the
# Paystack inline popup instead of the hosted checkout page.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Long random string used to sign download links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it immediately invalidates every link already issued.
DOWNLOAD_SIGNING_SECRET=

# Public site URL, no trailing slash. Used for the Paystack callback and for
# building download links. Must match the deployed domain.
SITE_URL=https://your-domain.com

# Price in naira. The server charges this amount, not the number in the page.
PRODUCT_PRICE_NGN=2500
PRODUCT_ID=dear-daughter-ebook-v1
PRODUCT_NAME=Dear Daughter, Let's Talk About Growing Up

# --- The file that buyers receive -----------------------------------------

# Preferred: a PRIVATE Vercel Blob URL holding the final PDF.
# The PDF must never sit in /public or in the git repository.
EBOOK_BLOB_URL=
BLOB_READ_WRITE_TOKEN=

# Local development only: absolute path to the PDF on your machine.
EBOOK_FILE_PATH=

# Name the buyer's file is saved as.
EBOOK_FILENAME=Dear-Daughter-Growing-Up-Guide.pdf

# How long a download link stays valid, and how many times it may be used.
DOWNLOAD_TTL_MINUTES=60
MAX_DOWNLOADS_PER_ORDER=8

# --- Email delivery (optional, recommended) -------------------------------

# Resend API key and a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=Dear Daughter <hello@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# --- Webhook idempotency and download counting (optional) -----------------

# Upstash Redis REST credentials. Without these the counters fall back to
# per-instance memory, which does not survive a redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Advertising measurement (optional) -----------------------------------

# Server side Conversions API. The browser Pixel ID goes in
# src/config/site.ts; this pair is for the server.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set only while testing in Events Manager, then remove.
META_TEST_EVENT_CODE=
