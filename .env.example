# ---------------------------------------------------------------------------
# This site is static. It is built by GitHub Actions and served by GitHub
# Pages, so there is no server and no place to keep a secret.
#
# That means the Paystack SECRET key is never used here, and must never be
# put in this file or anywhere else in this repository. Only the public key
# below is needed, and it is safe to be visible: it can start a payment, but
# it cannot move money or read your transactions.
# ---------------------------------------------------------------------------

# Paystack PUBLIC key. pk_test_... while testing, pk_live_... when you launch.
# Copy to .env.local for local work. For the live site, add it as a repository
# variable or secret named VITE_PAYSTACK_PUBLIC_KEY and pass it to the build
# step in .github/workflows/deploy.yml.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
